{
  "name": "@laynepeng/dsh-email",
  "version": "0.1.0",
  "description": "邮件助手（DSH 插件）：Hotmail/Outlook OAuth2 设备码授权 + 通用 SMTP 发信，让 AI 真正把邮件发出去。零运行时依赖。",
  "license": "MIT",
  "author": "Layne Peng <appamail@hotmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LaynePeng/dsh-email.git"
  },
  "homepage": "https://github.com/LaynePeng/dsh-email#readme",
  "bugs": {
    "url": "https://github.com/LaynePeng/dsh-email/issues"
  },
  "type": "module",
  "main": "./lib/entry.js",
  "exports": {
    ".": "./lib/entry.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "NOTICE",
    "LICENSE",
    "LICENSES",
    "docs/preview.png"
  ],
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.0-rc.2 || >=0.2.1-rc.2 || >=0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2 || >=3.18.6-alpha.2 <4.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "email",
    "smtp",
    "oauth2",
    "outlook",
    "hotmail",
    "graph"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check:tools": "node scripts/check-tools.mjs",
    "selftest": "node scripts/selftest.mjs"
  }
}
